{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Merge all dependency updates after complete current-head CI, without dashboard approval.",
  "automerge": true,
  "dependencyDashboardApproval": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "automerge": true,
      "dependencyDashboardApproval": false
    }
  ]
}
